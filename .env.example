# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google Maps JavaScript API key, restricted to your domains
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional: a Map ID from Google Cloud for custom map styling.
# Falls back to Google's demo Map ID when left empty.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
